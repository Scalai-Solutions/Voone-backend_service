generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Health {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())
}

model Clinic {
  id          String   @id @default(uuid())
  name        String
  addressLine String
  pincode     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// The URL key printed on a QR poster. Lowercase, because Postgres unique is
  /// case-sensitive and a slug gets typed by hand off that poster.
  slug String @unique

  /// Which privacy notice a member is shown at sign-up. Per clinic rather than a global
  /// constant: the clinic is the data controller, Voone is the processor.
  ///
  /// v2 from the sign-up form collecting year of birth and sex. Existing clinics keep
  /// whatever they were set to — the version has to describe the notice a member was
  /// actually shown, so moving it for everyone would make the stored evidence a lie.
  privacyPolicyVersion String @default("v2")

  /// A churned clinic's poster stays in its waiting room for months. Inactive clinics
  /// 404 rather than 403, so the response never confirms they existed.
  isActive Boolean @default(true)

  /// Commercial plan owned by Voone, not the clinic's own loyalty tier.
  voonePlan String @default("starter")

  /// Monthly manual notification allowance. Defaults match the public Starter plan.
  notificationsMonthlyQuota  Int @default(8)
  notificationsUsedThisMonth Int @default(0)

  /// Billing details for invoicing the centre: who and where the invoice goes. All optional:
  /// a centre that never filled them in is still billable by its commercial name and address.
  /// An empty string clears a field (null in the database).
  billingName        String?
  billingTaxId       String?
  billingEmail       String?
  billingAddressLine String?
  billingPostalCode  String?

  users                 User[]
  treatments            ClinicTreatment[]
  template              ClinicTemplate?
  members               Member[]
  pointsLedger          PointsTransaction[]
  notifications         Notification[]
  notificationSettings  ClinicNotificationSettings?
  notificationLocations ClinicLocation[]
  notificationAuditLogs NotificationAuditLog[]
  catalogItems          CatalogItem[]
  onboardingPrograms    OnboardingProgram[]
  paidVisits            PaidVisit[]
  memberRewards         MemberReward[]
  referrals             Referral[]
  bonoPlans             BonoPlan[]
  memberBonos           MemberBono[]
  clinicAudiences       ClinicAudience[]
}

model User {
  id                            String    @id @default(uuid())
  clinicId                      String?
  clinic                        Clinic?   @relation(fields: [clinicId], references: [id])
  name                          String?
  email                         String    @unique
  passwordHash                  String?
  onboardingPasswordGeneratedAt DateTime?
  onboardingCredentialsSentAt   DateTime?
  role                          UserRole
  permissions                   String[]  @default([])
  createdAt                     DateTime  @default(now())

  passwordSetupTokens PasswordSetupToken[]

  @@index([clinicId])
}

model PasswordSetupToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  VOONE_ADMIN
}

model ClinicTreatment {
  id             String   @id @default(uuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id])
  name           String
  priceEuro      Int?
  pointsAllotted Int
  createdAt      DateTime @default(now())

  @@index([clinicId])
}

model TemplatePreset {
  id                 String   @id @default(uuid())
  name               String   @unique
  hexBackgroundColor String
  previewImageUrl    String?
  createdAt          DateTime @default(now())

  templates      ClinicTemplate[]
  vooneTemplates VooneTemplate[]
}

model VooneTemplate {
  id                 String          @id @default(uuid())
  presetId           String?
  preset             TemplatePreset? @relation(fields: [presetId], references: [id])
  name               String
  description        String?
  programName        String
  hexBackgroundColor String
  logoUrl            String?
  heroImageUrl       String?
  pointsLabel        String
  tierLabel          String
  benefitsText       String?
  infoText           String?
  buttons            Json            @default("[]")
  textModules        Json            @default("[]")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([presetId])
}

model ClinicTemplate {
  id                 String         @id @default(uuid())
  clinicId           String         @unique
  clinic             Clinic         @relation(fields: [clinicId], references: [id])
  presetId           String
  preset             TemplatePreset @relation(fields: [presetId], references: [id])
  programName        String
  hexBackgroundColor String
  logoUrl            String?
  /// Optional second logo drawn on the Apple pass, for a logo that does not read on the card colour.
  logoOnDarkUrl      String?
  heroImageUrl       String?
  websiteUrl         String?
  appointmentUrl     String?
  appLinkText        String?
  appLinkDescription String?
  pointsLabel        String
  tierLabel          String
  benefitsText       String
  infoText           String
  tierRewards        Json           @default("[]")
  milestoneRewards   Json           @default("{\"milestoneCount\":10,\"pointsToNextMilestone\":2000,\"priceAmount\":10,\"pointsAwarded\":100}")
  status             TemplateStatus @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  walletClasses WalletClass[]

  @@index([presetId])
}

/// One row per card-design save that changed something, so a support question about "who
/// changed our card" has an answer. Plain columns rather than relations: this is an audit
/// trail and must outlive the template row it describes.
model TemplateChange {
  id            String   @id @default(uuid())
  clinicId      String
  templateId    String
  /// The signed-in user's email from the x-actor header; null when the caller sent none.
  changedBy     String?
  changedFields String[]
  /// Members holding a live wallet pass at the moment of the save: how many cards the change reached.
  cardsAtSave   Int
  createdAt     DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([templateId])
}

enum TemplateStatus {
  PENDING
  ACTIVE
  FAILED
}

model Member {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  name     String

  /// Canonical E.164, written only by normalizeSpanishMobile. A database CHECK enforces
  /// the shape, because the unique index below only detects duplicates if every writer
  /// agrees on the canonical form.
  ///
  /// Nullable so the dashboard's add-by-email path still works: Postgres treats NULLs as
  /// distinct in a unique index, so one clinic can hold many email-only members while a
  /// real number still cannot repeat.
  phone String?

  email         String?
  code          String?
  pointsBalance Int     @default(0)
  tier          String?

  /// Lifetime points earned, cached alongside pointsBalance and for the same reason:
  /// a pass is rebuilt on issue, on every sync and on every device fetch, and a member
  /// with years of visits must not cost a full ledger scan each time.
  ///
  /// Distinct from pointsBalance, which is spendable. This one never decreases when a
  /// member redeems, which is what stops spending a reward demoting them — and it is
  /// what the milestone and tier engines read.
  lifetimePoints Int      @default(0)
  createdAt      DateTime @default(now())

  /// The submission verbatim. Without it, changing the normalization rules is data loss
  /// rather than a backfill.
  phoneRaw          String?
  normalizerVersion Int     @default(1)

  /// True when no country code was supplied and Spain was inferred, which is most rows.
  /// An audit filter, not an alarm — see phone-es.ts.
  phoneRegionAssumed Boolean @default(false)

  /// Europe/Madrid year, frozen at sign-up rather than derived from createdAt at render
  /// time: the container runs UTC, so a sign-up at 23:30 on the 31st of December would
  /// print the previous year on something that reads as a physical card. Nullable because
  /// it is derived data and a member created outside this flow legitimately has none.
  memberSince Int?

  locale String @default("es-ES")

  /// Year of birth retained for members captured before the form collected a full date.
  birthYear Int?

  /// Full date of birth, stored as a Postgres DATE. Optional: members who signed up
  /// before this field existed have no honest day/month to backfill.
  birthDate DateTime? @db.Date

  /// Self-declared, and free text within a small set rather than an enum: "prefer not to
  /// say" has to be a first-class answer, and a database enum would make adding one a
  /// migration. Optional for the same reason as birthYear.
  ///
  /// Ordinary personal data, not GDPR Art. 9 special category — but it is new data the
  /// privacy notice did not previously cover, which is why privacyPolicyVersion moves.
  sex String?

  /// Required, with no default. Membership itself rests on performance of a contract, so
  /// what must be recorded is that a choice was made; a default would let an absent
  /// choice be read as one, which is the accountability failure the column prevents.
  consentMarketing   Boolean
  consentMarketingAt DateTime?

  /// Snapshot of the notice actually shown, not a foreign key: the evidence is what the
  /// member read, and a reference to an editable row destroys it.
  privacyPolicyVersion String?

  /// When the person ticked acceptance of the processing of their data on the QR form. Null for
  /// members entered by staff, who are not asked.
  privacyAcceptedAt DateTime?

  /// How the member was collected — "qr_signup", "staff_entry". Required for the same
  /// reason as consentMarketing: provenance is not a safe thing to assume.
  consentSource String

  /// A re-scan at reception bumps these instead of rewriting the name, which would let
  /// anyone who knows a phone number rename a real member.
  signupCount  Int      @default(1)
  lastSignupAt DateTime @default(now())

  /// Erasure overwrites the row in place rather than deleting it, so a future points
  /// ledger keeps its references. phone becomes a random tombstone, which keeps the
  /// unique index satisfiable and lets the person register again later.
  erasedAt DateTime?

  walletObjects          WalletObject[]
  pointsLedger           PointsTransaction[]
  passClaims             PassClaim[]
  paidVisits             PaidVisit[]
  rewards                MemberReward[]
  bonos                  MemberBono[]
  referralsMade          Referral[]             @relation("Referrer")
  referredBy             Referral?              @relation("Referred")
  notificationDeliveries NotificationDelivery[]
  walletMessage          MemberWalletMessage?

  @@unique([clinicId, phone])
  @@unique([clinicId, code])
  @@index([clinicId])
}

model WalletClass {
  id               String             @id @default(uuid())
  clinicTemplateId String
  clinicTemplate   ClinicTemplate     @relation(fields: [clinicTemplateId], references: [id])
  provider         WalletProviderType
  externalClassId  String
  status           WalletSyncStatus   @default(PENDING)
  lastSyncedAt     DateTime?
  createdAt        DateTime           @default(now())

  @@unique([clinicTemplateId, provider])
}

model WalletObject {
  id               String             @id @default(uuid())
  memberId         String
  member           Member             @relation(fields: [memberId], references: [id])
  provider         WalletProviderType
  externalObjectId String
  status           WalletSyncStatus   @default(PENDING)
  lastSyncedAt     DateTime?
  createdAt        DateTime           @default(now())

  @@unique([memberId, provider])
  /// Apple addresses a pass by serial alone, so the web service looks rows up that way.
  @@index([externalObjectId])
}

/// The bearer secret one Apple pass authenticates with.
///
/// Its own table rather than a column on WalletObject, for two reasons. It is meaningful
/// only to a provider whose pass is a file on a device, so it does not belong on a model
/// both providers share. And it has to be written before the pass is signed — the token
/// goes inside the file — which is before the WalletObject row exists.
///
/// Stored, never derived from the serial: serials travel in URLs and barcodes, so anyone
/// who saw one could otherwise read or deregister that member's pass.
model ApplePassCredential {
  /// Part of the key, not decoration. Apple identifies a pass by
  /// (passTypeIdentifier, serialNumber), and our serials are derived from the member so
  /// they repeat across pass types. Keyed on the serial alone, issuing a pass under a new
  /// pass type would overwrite the token of the one the member is still carrying, and
  /// that pass would start failing every web service call immediately.
  ///
  /// This is what lets an old and a new pass type coexist while members move across.
  passTypeIdentifier  String
  serialNumber        String
  authenticationToken String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  /// Evidence the pass reached a person, which the WalletObject cannot give: that row is
  /// written when the pass is ISSUED, so an Android member or an iPhone member who never
  /// tapped Add has a SYNCED Apple object too.
  ///
  /// The last time a .pkpass was served to a person (staff download, claim link or the
  /// public pass page). Moved on every download, so it reads as "last handed a pass".
  downloadedAt DateTime?

  /// The first time any phone registered for this pass. Set once and never cleared, so it
  /// outlives the registration row: iOS deletes that row when the member turns Automatic
  /// Updates off, and "was registered, now is not" is precisely the case staff must see.
  firstRegisteredAt DateTime?

  @@id([passTypeIdentifier, serialNumber])
}

/// One device's request to be told when one pass changes.
///
/// Apple's own table, in effect: the device supplies all four values and we hand the push
/// token back to APNs when the pass is republished. Not tied to Member by a foreign key —
/// the device knows only the serial, and an erased member's row must still be findable so
/// its registrations can be cleared.
model PassDeviceRegistration {
  id                      String   @id @default(uuid())
  deviceLibraryIdentifier String
  passTypeIdentifier      String
  serialNumber            String
  pushToken               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  /// A device registers a given pass once. Re-registering replaces the push token, which
  /// is what Apple expects when a token is rotated.
  ///
  /// Scoped by pass type for the same reason as ApplePassCredential: one device can hold
  /// the old and the new pass at once during a migration, and those are two registrations,
  /// not one overwriting the other.
  @@unique([deviceLibraryIdentifier, passTypeIdentifier, serialNumber])
  /// The updated-serials endpoint filters by both.
  @@index([deviceLibraryIdentifier, passTypeIdentifier])
  /// Fan-out on republish goes the other way: serial to every device holding it.
  @@index([serialNumber])
}

enum WalletProviderType {
  GOOGLE
  APPLE
}

enum WalletSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum NotificationType {
  BROADCAST
  SEGMENT
  SINGLE
  POINTS
  TIER
  BIRTHDAY
  /// Monthly reminder to members with an active bono that they have sessions left.
  BONO_REMINDER
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  PARTIAL_FAILED
  FAILED
  CANCELLED
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  DOWNGRADED
  FAILED
  SKIPPED
}

enum ClinicNotifyOnCredit {
  NEVER
  MILESTONE_AND_TIER
  ALWAYS
}

model Notification {
  id                String             @id @default(uuid())
  clinicId          String
  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  type              NotificationType
  header            String
  body              String
  actionUrl         String?
  notify            Boolean
  segmentJson       Json?
  status            NotificationStatus @default(QUEUED)
  scheduledAt       DateTime?
  createdBy         String?
  createdAt         DateTime           @default(now())
  providerMessageId String?
  idempotencyKey    String?

  deliveries NotificationDelivery[]
  auditLogs  NotificationAuditLog[]

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, createdAt])
}

model NotificationDelivery {
  id                String                     @id @default(uuid())
  notificationId    String
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  memberId          String
  member            Member                     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  provider          WalletProviderType
  status            NotificationDeliveryStatus @default(QUEUED)
  errorCode         String?
  sentAt            DateTime?
  providerMessageId String?

  @@index([notificationId, status])
  @@index([memberId])
}

/// The latest clinic message shown on a member's Apple card: one row per member, overwritten by
/// each new message. Apple has no free-form push, so the message rides in a pass field whose
/// changeMessage fires when the value changes. sentAt is stored, never read from the clock at
/// build time, so rebuilding the pass is stable and does not re-notify.
model MemberWalletMessage {
  memberId       String   @id
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  header         String
  body           String
  sentAt         DateTime
  notificationId String?
  updatedAt      DateTime @updatedAt
}

model ClinicNotificationSettings {
  id                  String               @id @default(uuid())
  clinicId            String               @unique
  clinic              Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  notifyOnCredit      ClinicNotifyOnCredit @default(MILESTONE_AND_TIER)
  marketingEnabled    Boolean              @default(true)
  birthdayEnabled     Boolean              @default(true)
  birthdayHeader      String               @default("¡Feliz cumpleaños!")
  birthdayBody        String               @default("¡Feliz cumpleaños! Disfruta de un 10% de descuento en nuestros servicios. Esperamos verte pronto.")
  birthdayNotify      Boolean              @default(true)
  birthdayLastRunDate String?

  /// The monthly "you have sessions left" automation. Sent on the 1st to members with an
  /// ACTIVE bono and a synced pass, regardless of marketing consent: the sessions are
  /// already paid for, so this is about the member's own purchase. The clinic's toggle is
  /// bonoReminderEnabled.
  bonoReminderEnabled      Boolean  @default(true)
  bonoReminderHeader       String   @default("Tienes sesiones pendientes")
  bonoReminderBody         String   @default("Te quedan sesiones de tu bono. Reserva tu próxima cita cuando quieras.")
  bonoReminderNotify       Boolean  @default(true)
  bonoReminderLastRunMonth String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model ClinicLocation {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

model NotificationAuditLog {
  id             String        @id @default(uuid())
  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  actorId        String?
  action         String
  recipientCount Int
  payloadJson    Json?
  createdAt      DateTime      @default(now())

  @@index([clinicId, createdAt])
  @@index([notificationId])
}

/// Why points moved. The set is closed on purpose: "some other reason" is what turns a
/// ledger into a log nobody can reconcile.
enum PointsTransactionKind {
  EARN
  REDEEM
  ADJUSTMENT
  REFERRAL
  EXPIRY
}

/// The points ledger. Append-only: no updates, no deletes, no soft-delete column.
///
/// The absence of `updatedAt` is the design. A balance that can be edited cannot answer
/// "why do I have 340 points?", and it cannot be recomputed after a crediting bug — the
/// wrong number simply becomes the truth. Every balance in the system is derived from
/// these rows, so a bug is fixed by correcting the ledger and replaying it.
///
/// Deliberately holds NO treatment data. An append-only table and the Art. 17 right to
/// erasure cannot both hold if special-category data is in it: erasing would mean
/// breaking the one invariant this table exists to guarantee. Treatments, if a clinic is
/// ever permitted to record them (VOO-5), live in their own erasable table that this one
/// references by id and does not depend on. See
/// docs/superpowers/specs/2026-09-25-points-ledger-design.md.
model PointsTransaction {
  id       String @id @default(uuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  /// Denormalised from the member so a clinic's whole ledger is one index scan. Metrics
  /// read it far more often than a single member's history does.
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  /// Signed. Positive earns, negative spends — one column rather than two, so the
  /// spendable balance is a plain SUM and cannot disagree with itself. A database CHECK
  /// enforces the sign against the kind, because "a REDEEM that added points" is the
  /// kind of bug that is invisible until an audit.
  points Int
  kind   PointsTransactionKind

  /// Staff-authored, for ADJUSTMENT. Free text and therefore never a treatment name:
  /// the UI must not offer one, and nothing here should be parsed.
  reason String?

  /// Opaque pointer at whatever caused this — a scan, an import, a referral. Carries no
  /// meaning to this table.
  sourceRef String?

  /// The double-redemption guard (VOO-21). A retried request carries the same key and
  /// the insert is rejected, so a member cannot be charged twice by a double tap or a
  /// queue redelivery. Unique across the whole table, not per member: keys are minted
  /// from the operation, not from the member.
  idempotencyKey String @unique

  createdAt DateTime @default(now())

  /// The staff user who caused it, null for system-generated rows. Present because
  /// manual adjustment (VOO-65) is the one place a person can mint points by hand.
  createdBy String?

  /// Every read of a member's ledger is "this member, in order".
  @@index([memberId, createdAt])
  /// Metrics go the other way: a clinic's movements over a period.
  @@index([clinicId, createdAt])
}

/// A short-lived permission to download one member's pass, handed to the browser that
/// just created that member.
///
/// Exists because the QR sign-up page must hand over the card at the moment the member
/// is standing there, and the staff-key route cannot be used from a member's phone.
///
/// The token is stored HASHED. A claim URL ends up in browser history and in whatever
/// the phone syncs, so the row must not be enough to mint a pass if the database leaks.
///
/// Issued only when the member was newly CREATED. An existing phone number gets no
/// claim, which is what stops someone typing a stranger's number and receiving their
/// name and points. See docs/superpowers/specs and VOO-102.
model PassClaim {
  id        String @id @default(uuid())
  /// SHA-256 of the token. Unique so a collision is a database error, not a silent swap.
  tokenHash String @unique

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// Minutes, not days. The window is the real control: it is short enough that a URL
  /// left in history is worthless long before anyone finds it.
  expiresAt DateTime

  /// First use. Recorded rather than enforced as single-use on purpose — a member whose
  /// "Add to Wallet" fails must be able to tap again, and re-submitting the form would
  /// return "already a member" and no new token.
  claimedAt DateTime?

  createdAt DateTime @default(now())

  /// For the sweep that deletes expired rows.
  @@index([expiresAt])
}

/// One row of a centre's price list, as the onboarding engine consumes it.
///
/// SEPARATE FROM ClinicTreatment, and not by preference. The engine's determinism rests
/// on stable item ids — they are the final tie-break in every sort — and
/// treatmentsRepository.replaceForClinic deletes every row and recreates it on each
/// template save, minting fresh uuids. A catalogue stored that way would generate a
/// different ladder after an unrelated edit to the card's copy.
///
/// This duplication is real and is meant to be temporary. ClinicTreatment carries
/// `pointsAllotted`, a per-treatment points award that the engine's progress-in-euros
/// model replaces outright. When the onboarding wizard is rewritten, ClinicTreatment
/// should be retired and its two readers — the staff credit screen and the template
/// flow — moved onto this table. Until then the two coexist, and whichever one a screen
/// reads must be a deliberate choice rather than whichever came to hand.
model CatalogItem {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// The id the engine sees, stable for the life of the row. Taken from the centre's own
  /// export when it has one, generated otherwise. Unique per clinic so an import can
  /// address a row it has seen before without guessing at our uuid.
  externalId String

  name String

  /// Cents, not euros. The engine does float arithmetic on euros and a decimal column
  /// read back as a float is the classic way to get a ladder that differs by a cent and
  /// therefore by a tie-break. An integer converts to the same euro value every time.
  priceCents Int

  durationMin Int?

  /// Retail product. Forces category COS in the engine.
  isProduct Boolean @default(false)

  /// Category the centre chose. Null means the engine classifies by keyword.
  /// Deliberately a string rather than an enum: the category list lives in the versioned
  /// engine config, and a database enum would make adding one a migration.
  categoryId String?

  /// The centre's own cost ratio for this row, 0 to 1. Beats the category default.
  costPctOverride Float?

  /// The price is Voone's estimate rather than the centre's figure, so it is excluded
  /// from ticket estimation.
  estimated Boolean @default(false)

  /// How the stored category was arrived at: "centro", "producto", "palabra clave" or
  /// "sin clasificar". Kept so the review screen can show the centre why a row is filed
  /// where it is.
  classificationSource String?

  /// Nothing matched, so the centre must choose. Blocks programme approval.
  needsReview Boolean @default(false)

  /// Position in the catalogue, and part of the engine's contract: the beam search keeps
  /// a bounded number of states, so input order can change which survive. A centre's
  /// catalogue must therefore be passed in a fixed order, and this is that order.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, externalId])
  @@index([clinicId, position])
}

/// A generated loyalty programme: the engine's whole output, with the inputs that made it.
///
/// Stored verbatim rather than normalised into milestone rows. The output is the audit
/// record — regenerating it must be possible years later, which needs the catalogue
/// snapshot, the answers and both version strings together. Splitting it across tables
/// would make "what exactly did this centre approve" a join that can drift.
model OnboardingProgram {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// Monotonic per clinic. A recalibration or an answer change writes a new version
  /// rather than editing one, so a published programme is never altered underneath a
  /// member who is part way up its ladder.
  version Int

  status OnboardingProgramStatus @default(BORRADOR)

  /// Which code and which numbers produced this. Both are needed: the same engine with a
  /// recalibrated config gives a different ladder.
  engineVersion String
  configVersion String

  /// The six answers, exactly as submitted.
  answers Json

  /// The engine's Program object, whole.
  output Json

  /// The catalogue as it stood when this was generated. Without it the output cannot be
  /// reproduced, because the engine reads prices and ids that the centre may since have
  /// edited.
  catalogSnapshot Json

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rewards MemberReward[]

  @@unique([clinicId, version])
  @@index([clinicId, status])
}

enum OnboardingProgramStatus {
  /// Generated and waiting for the centre. Carries review notes it must clear first.
  BORRADOR
  /// Live. Members earn against this programme's thresholds.
  ACTIVO
  /// Replaced by a later version. Kept, never deleted: members progressed against it.
  SUSTITUIDO
}

enum VisitKind {
  /// Money changed hands for something that earns progress.
  PAYMENT
  /// One session of a prepaid package was consumed. The package was paid for earlier;
  /// progress is added per session, never as a lump sum at purchase.
  BONO_SESSION
}

enum VisitSource {
  /// Reception typed it in. The only source that exists today.
  STAFF_ENTRY
  /// Reserved: a QR scanned at the till. Not accepted by any route yet.
  QR_SCAN
  /// Reserved: pushed by the centre's own management software. Not accepted yet.
  INTEGRATION
}

/// A visit that included a payment or a consumed prepaid session.
///
/// This exists because the guide makes redemption conditional on it: "the backend must
/// validate this; it is not a staff convention". A reward can only be redeemed against one
/// of these, so the rule is enforced by what the database can show rather than by what
/// reception remembers.
///
/// Deliberately SOURCE-AGNOSTIC. How a payment reaches Voone — typed by staff, scanned at
/// the till, or pushed from the centre's own software — is an open question in the guide,
/// and it must not be answered by accident in a schema. `source` records the channel; the
/// redemption rule only cares that the row exists.
///
/// Holds amounts and counts, never what was bought. Treatment names are special-category
/// data in this product's design (see PointsTransaction), and a table that must be kept
/// as a financial record cannot also be erasable.
model PaidVisit {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  kind   VisitKind
  source VisitSource @default(STAFF_ENTRY)

  /// For PAYMENT, what was paid that earns progress. For BONO_SESSION, the package price
  /// divided by its sessions. Cents, for the same reason as CatalogItem.priceCents.
  amountCents Int

  /// False when the visit was retail only. A referral counts on the referred person's
  /// first payment for a TREATMENT, so buying a moisturiser must not trigger it.
  hasTreatment Boolean @default(true)

  /// Cosmetics bought at the tier discount in this visit. Counted against the yearly
  /// allowance rather than stored as a running total, so a correction is a row, not an
  /// edit.
  discountedProducts Int @default(0)

  /// Minted by the caller. A double tap at reception must not pay a client twice.
  idempotencyKey String

  /// Snapshots taken when the progress was credited. They make the milestones this visit
  /// crossed a fact about THIS visit, independent of whatever the member does afterwards:
  /// a retry an hour later must not see the same thresholds as crossed by someone else's
  /// later visit.
  progressAwarded Int?
  lifetimeBefore  Int?
  lifetimeAfter   Int?

  occurredAt DateTime
  createdAt  DateTime @default(now())
  createdBy  String?

  /// The bono this session was consumed from. Null for a PAYMENT visit, and set to null if
  /// the bono row is ever removed: the financial record keeps its amounts either way.
  memberBonoId String?
  memberBono   MemberBono? @relation(fields: [memberBonoId], references: [id], onDelete: SetNull)

  /// 1-based position within the bono — "session 3 of 5". Unique per bono, which is what
  /// stops a double tap at reception from burning two sessions.
  bonoSessionNumber Int?

  /// Whole euros of progress awarded by hand with this visit ("bonus points", optional).
  /// Included in progressAwarded, held separately so an audit can tell purchase from gift.
  bonusProgress Int?

  redemptions MemberReward[] @relation("RedeemedAt")

  @@unique([clinicId, idempotencyKey])
  @@unique([memberBonoId, bonoSessionNumber])
  @@index([memberId, occurredAt])
  @@index([clinicId, occurredAt])
}

/// A session-pack treatment the centre sells: a fixed price per session, paid up front and
/// consumed over a fixed number of visits ("bono de sesiones").
///
/// Its own table rather than a CatalogItem row, because the catalogue is REPLACED wholesale
/// by the onboarding editor (PUT /catalog), so a bono would not survive a re-import — and
/// the programme engine never sees it, so it cannot shift the ladder's economics.
model BonoPlan {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name String

  /// Cents, not euros: a session's progress is exactly this, never a rounded division of a
  /// package price, so five sessions at 39,90 € earn 39,90 € each and not 39,88.
  pricePerSessionCents Int

  /// The whole pack. 1 to 100; the service enforces the bounds.
  totalSessions Int

  /// Soft delete: a plan a member may still be mid-way through must not vanish from the
  /// picker list without the owner meaning it to.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issued MemberBono[]

  @@index([clinicId])
}

enum MemberBonoStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// A bono a member holds: the centre's plan SNAPSHOTTED, plus how far through it they are.
///
/// The snapshot is deliberate: a plan's price or session count must not change underneath a
/// member who is part-way through consuming what they paid for — the same rule the
/// programme versions follow. planId remains as a soft reference for the editor, null once
/// the plan is deleted.
///
/// It holds the treatment NAME, so it is erasable data in its own table: member erasure
/// removes these rows, while the financial record (PaidVisit, amounts only) survives.
model MemberBono {
  id       String    @id @default(uuid())
  clinicId String
  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  memberId String
  member   Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId   String?
  plan     BonoPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  /// Snapshot taken when the bono starts, so later plan edits don't rewrite history.
  name                 String
  pricePerSessionCents Int
  totalSessions        Int

  /// Sessions consumed so far.
  sessionsUsed Int @default(0)

  status      MemberBonoStatus @default(ACTIVE)
  startedAt   DateTime         @default(now())
  cancelledAt DateTime?

  createdAt DateTime @default(now())

  /// The visits that consumed this bono. PaidVisit keeps its own bonoSessionNumber, so the
  /// financial record needs nothing from this table.
  visits PaidVisit[]

  @@index([clinicId, status])
  @@index([memberId, status])
}

enum MemberRewardKind {
  /// A reward from the ladder, picked from the centre's own catalogue.
  PREMIO
  /// A perk: double progress, a free diagnosis, an upgrade, a surprise.
  VENTAJA
  /// The reward that repeats every so often after Diamante.
  RECURRENTE
  /// Earned by referring someone who then paid for a treatment.
  REFERIDO
}

/// A reward or perk that has been issued to a member and is waiting to be used.
///
/// Issued when progress crosses a milestone, and expires 60 days later. Redeemed only
/// against a PaidVisit. Never deleted: what a member was promised, and when, has to
/// survive the programme being replaced.
model MemberReward {
  id        String            @id @default(uuid())
  clinicId  String
  clinic    Clinic            @relation(fields: [clinicId], references: [id])
  memberId  String
  member    Member            @relation(fields: [memberId], references: [id])
  programId String
  program   OnboardingProgram @relation(fields: [programId], references: [id])

  kind MemberRewardKind

  /// What makes this issuance unique for the member: "m:7" for the seventh milestone of
  /// the programme, "rec:3" for the third recurring reward, "ref:5" for the fifth
  /// referral. Together with the member it is the idempotency key for issuing, so a
  /// retried visit cannot hand out a reward twice.
  sourceKey String

  /// Spanish, ready to show: the reward's name or the perk's.
  title String

  /// Whatever the screen needs to render it: the perk's kind and description, the items
  /// in a reward, and for a surprise the pool the centre chooses from.
  detail Json

  issuedAt  DateTime @default(now())
  expiresAt DateTime

  redeemedAt      DateTime?
  redeemedVisitId String?
  redeemedVisit   PaidVisit? @relation("RedeemedAt", fields: [redeemedVisitId], references: [id])
  redeemedBy      String?

  /// For a surprise: which pool item the centre chose when it was redeemed. The guide
  /// leaves open whether staff pick from the pool or type free text; picking is the
  /// stricter reading and can be loosened, whereas the reverse cannot be recovered.
  surpriseItem String?

  @@unique([memberId, sourceKey])
  @@index([memberId, expiresAt])
  @@index([clinicId, issuedAt])
}

/// Who recommended whom.
///
/// Created when a new member says who sent them, but only COUNTS once they make their
/// first payment for a treatment — sign-up alone does not. `referredId` is unique: a
/// person can be recommended once, so a rival referral cannot steal the credit.
model Referral {
  id         String @id @default(uuid())
  clinicId   String
  clinic     Clinic @relation(fields: [clinicId], references: [id])
  referrerId String
  referrer   Member @relation("Referrer", fields: [referrerId], references: [id])
  referredId String @unique
  referred   Member @relation("Referred", fields: [referredId], references: [id])

  createdAt DateTime  @default(now())
  /// Set on the referred person's first treatment payment. The count is cumulative and
  /// never resets or expires, so this is only ever written once.
  countedAt DateTime?

  @@index([referrerId, countedAt])
  @@index([clinicId])
}

/// A named, saved audience (the Audiencias tab): the segment criteria a centre reuses,
/// stored on the clinic so they survive a browser and the whole team sees the same list.
model ClinicAudience {
  id        String   @id @default(uuid())
  clinicId  String
  name      String
  /// The same criteria a segment send accepts (tier, activeBono, inactiveDays, ...), kept as
  /// JSON so what a centre saves is exactly what a send can target.
  criteria  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}
