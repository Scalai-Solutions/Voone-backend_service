{
  "name": "voone-backend-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json && npm run copy:pass-assets",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "wallet:verify-class-links": "tsx scripts/verify-google-wallet-class-links.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy:pass-assets": "node scripts/copy-pass-assets.mjs",
    "apple:check": "tsx scripts/check-apple-wallet.ts",
    "worker": "node dist/jobs/wallet-sync.worker.js",
    "worker:dev": "tsx watch src/jobs/wallet-sync.worker.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bullmq": "^6.3.8",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "passkit-generator": "3.6.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.3",
    "prettier": "^3.6.2",
    "prisma": "6.12.0",
    "railway": "^3.11.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.0"
  }
}
