# PostgreSQL connection string Prisma uses at RUNTIME (the app's queries).
#
# Supabase (Supavisor pooler): use the TRANSACTION mode port 6543 with pgbouncer=true.
# Transaction mode multiplexes the app's connections over a few server sessions, so a busy
# API can no longer exhaust the pooler's session-mode slots (the EMAXCONNSESSION error).
# connection_limit caps Prisma client pool.
#
# MIGRATIONS: DDL does not survive the transaction pooler, so run them with a temporary
# override pointing DATABASE_URL at the session/direct port 5432, e.g.:
#   DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-XXXX.pooler.supabase.com:5432/postgres" npx prisma migrate dev
#
# Local Postgres with no pooler: one plain URL, and no override needed for migrations.
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-XXXX.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DATABASE_URL="postgresql://voone:voone@localhost:5432/voone?schema=public"

# Redis connection string used by queues and cache integrations.
REDIS_URL="redis://localhost:6379"

# HTTP port for the Express server.
PORT="4000"

# Allowed frontend origin for CORS. Single origin: a clinic-branded form served from
# another domain will fail with an opaque browser error and no server-side log.
FRONTEND_URL="http://localhost:3000"

# Optional. Required on template writes, and what distinguishes a staff sign-up from an
# anonymous one: staff calls skip the public rate limit and may record consentSource as
# "staff_entry". Unset, those checks are no-ops so local development needs nothing — except
# the rate-limit waiver, which is strict, because a forgotten variable must not switch off
# abuse protection.
#
# NEVER expose this to a browser. The dashboard's Next route handlers hold it server-side
# and derive the clinic from the session, so a staff caller cannot act on another clinic.
# STAFF_API_KEY=""

# Optional. Rejects requests that reach the origin directly instead of through the edge.
# Railway exposes a *.up.railway.app hostname that bypasses Cloudflare, so without this a
# caller can forge CF-Connecting-IP and mint unlimited rate-limit buckets. Set it together
# with a Cloudflare Transform Rule injecting the same value as the X-Voone-Edge header.
# Leave unset in development and CI, where the guard is a no-op.
# EDGE_SHARED_SECRET=""

# --- Apple Wallet pass signing ---
# Optional: the service boots without these and only pass generation is disabled.
# The pass type and team identifiers are read from the signing certificate itself
# (its subject UID and OU), so they are not configured here.

# Shown in the iOS "Add pass" sheet.
APPLE_WALLET_ORGANIZATION_NAME="Voone"

# base64 of the PEM Pass Type ID certificate: base64 -i signerCert.pem | tr -d '\n'
APPLE_WALLET_SIGNER_CERT_BASE64=""

# base64 of the PEM private key. Leave APPLE_WALLET_SIGNER_KEY_PASSPHRASE empty only
# if the key is unencrypted.
APPLE_WALLET_SIGNER_KEY_BASE64=""
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=""

# base64 of the PEM Apple WWDR intermediate certificate. Must be the generation that
# issued the signing certificate: openssl x509 -in signerCert.pem -noout -issuer
APPLE_WALLET_WWDR_CERT_BASE64=""

# Optional: override the bundled .pass model directory.
# APPLE_WALLET_PASS_MODEL_DIR=""

# --- Loyalty card ---
# Keys the HMAC that derives each member's barcode from their id. Rotating it changes
# every issued barcode at once, which is the argument for eventually storing the code on
# Member instead. Required, with the URL below, for the Apple pass web service to mount.
# CARD_REDEMPTION_SECRET=""

# --- Apple pass web service ---
# Base URL Apple appends "/v1/..." to, so it stops at /api — the pass routes sit under the
# existing /api/v1 router.
#
# BAKED INTO EVERY SIGNED PASS AND UNCHANGEABLE AFTERWARDS. A pass on a member's phone
# calls this host forever; point it at a deploy-scoped hostname and those passes stop
# updating with no way to reach them. Decide the permanent hostname before issuing the
# first real pass.
#
# Unset, the pass web service routes are not mounted at all.
# APPLE_PASS_WEB_SERVICE_URL="https://api.voone.ai/api"

# --- Wallet sync ---
# How a points change reaches the wallets.
#
# "inline" (default) runs the sync in the API process. No retries, no durability, and a
# restart loses anything in flight — but it needs no infrastructure, and the call sites
# are identical either way, so switching later is configuration rather than code.
#
# "queue" uses Redis and BullMQ and REQUIRES the worker process (`npm run worker`).
# Setting it without a worker means jobs pile up and no card ever updates.
# WALLET_SYNC_MODE="inline"

# Whether the API process also CONSUMES the queue, not just enqueues onto it.
#
# True by default. A durable queue with nobody consuming it is worse than no queue: jobs
# accumulate, every card goes stale, and nothing looks broken.
#
# Set it false on the API only once a dedicated worker service is running
# (`npm run worker`), at which point pass signing stops competing with request handling.
# WALLET_WORKER_IN_PROCESS="true"

# Optional in code, but set it to a public HTTPS URL in production. The plain Voone logo,
# used on a wallet card when a clinic has not set its own logo. Unset, such a card is sent
# to Google without a logo, and Google may reject a class created that way: clinics without
# their own logo then stay "google_pending". A clinic whose logo is this URL (or one of the
# old borrowed defaults) cannot be activated and is flagged in the admin list as using a
# default logo.
# VOONE_DEFAULT_LOGO_URL="https://example.com/voone-logo.png"

# --- Image uploads (Bunny.net) ---
# Logo and hero uploads are stored in a Bunny.net storage zone and served from its pull zone.
# Leave all of these unset to run without uploads: the upload routes then answer 503 and
# nothing else changes. Never commit the access key.

# Name of the storage zone (letters, digits, hyphens).
# BUNNY_STORAGE_ZONE="voone-storage"

# Regional storage endpoint, https, no trailing slash. Defaults to Frankfurt.
# BUNNY_STORAGE_ENDPOINT="https://storage.bunnycdn.com"

# The storage zone's WRITE password (zone > FTP & API Access > Password). Server-side only.
# BUNNY_STORAGE_ACCESS_KEY=""

# Public base URL of the pull zone linked to the storage zone, https, no trailing slash.
# BUNNY_PUBLIC_BASE_URL="https://voone-pullzone.b-cdn.net"

# Central notification dispatcher: ONE daily job that runs every time-based automation
# (birthday, inactive bono, Google review request, monthly referral push). Each send is
# idempotent, so a restart or a second replica cannot duplicate a message.
NOTIFICATION_DISPATCHER_ENABLED=true
NOTIFICATION_DISPATCH_TIME_ZONE=Europe/Madrid
NOTIFICATION_DISPATCH_HOUR=9
NOTIFICATION_DISPATCH_MINUTE=0

# Day of the month (1-28) on which the monthly referral-program push goes out.
REFERRAL_PUSH_DAY_OF_MONTH=1
