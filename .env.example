# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://voone:voone@localhost:5432/voone?schema=public"

# Redis connection string used by queues and cache integrations.
REDIS_URL="redis://localhost:6379"

# HTTP port for the Express server.
PORT="4000"

# Allowed frontend origin for CORS. Single origin: a clinic-branded form served from
# another domain will fail with an opaque browser error and no server-side log.
FRONTEND_URL="http://localhost:3000"

# Optional. Rejects requests that reach the origin directly instead of through the edge.
# Railway exposes a *.up.railway.app hostname that bypasses Cloudflare, so without this a
# caller can forge CF-Connecting-IP and mint unlimited rate-limit buckets. Set it together
# with a Cloudflare Transform Rule injecting the same value as the X-Voone-Edge header.
# Leave unset in development and CI, where the guard is a no-op.
# EDGE_SHARED_SECRET=""