# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://voone:voone@localhost:5432/voone?schema=public"

# Redis connection string used by queues and cache integrations.
REDIS_URL="redis://localhost:6379"

# HTTP port for the Express server.
PORT="4000"

# Allowed frontend origin for CORS.
FRONTEND_URL="http://localhost:3000"
# --- Apple Wallet pass signing ---
# Optional: the service boots without these and only pass generation is disabled.
# The pass type and team identifiers are read from the signing certificate itself
# (its subject UID and OU), so they are not configured here.

# Shown in the iOS "Add pass" sheet.
APPLE_WALLET_ORGANIZATION_NAME="Voone"

# base64 of the PEM Pass Type ID certificate: base64 -i signerCert.pem | tr -d '\n'
APPLE_WALLET_SIGNER_CERT_BASE64=""

# base64 of the PEM private key. Leave APPLE_WALLET_SIGNER_KEY_PASSPHRASE empty only
# if the key is unencrypted.
APPLE_WALLET_SIGNER_KEY_BASE64=""
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=""

# base64 of the PEM Apple WWDR intermediate certificate. Must be the generation that
# issued the signing certificate: openssl x509 -in signerCert.pem -noout -issuer
APPLE_WALLET_WWDR_CERT_BASE64=""

# Optional: override the bundled .pass model directory.
# APPLE_WALLET_PASS_MODEL_DIR=""
